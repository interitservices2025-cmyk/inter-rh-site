# Variables d'environnement — INTER-RH

# URL de base du site (production)
NEXT_PUBLIC_SITE_URL=https://inter-rh.com

# Email de réception des formulaires (si API email configurée)
NEXT_PUBLIC_CONTACT_EMAIL=contact@inter-rh.com

# Clé API service email (Resend, SendGrid, etc.)
# RESEND_API_KEY=re_xxxxxxxxxxxx

# Google Analytics (optionnel)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# reCAPTCHA (optionnel, pour protection des formulaires)
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
# RECAPTCHA_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# Configuration du serveur SMTP pour l'envoi de mail
# SMTP_HOST=smtp.votredomaine.com
# SMTP_PORT=587
# SMTP_USER=candidatures@inter-rh.com
# SMTP_PASS=votre_mot_de_passe_secret
# SMTP_SECURE=false # Mettre à true si port 465

